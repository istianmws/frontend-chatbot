---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ChatWidget from '../components/ChatWidget.astro';
import QuickInfoModal from '../components/QuickInfoModal.astro';
import { polyclinics, hospitalInfo } from '../data/hospitalData.js';
---

<Layout title="Chatbot CS Virtual - RS PKU Muhammadiyah Grabag">
  <div class="app-container">
    <!-- Header -->
    <Header />

    <!-- Main Content Area -->
    <main class="main-layout">
      <!-- Sidebar Info Panel (Desktop & Tablet) -->
      <aside class="sidebar-panel">
        <div class="sidebar-card glass-card">
          <!-- Hospital Mini Banner -->
          <div class="hospital-mini-hero">
            <div class="hero-chip">
              <span class="hero-chip-icon">🕌</span>
              <span>Layanan Islami & Terpercaya</span>
            </div>
            <h2 class="sidebar-hero-title">RS PKU Muhammadiyah Grabag</h2>
            <p class="sidebar-hero-desc">
              Pusat pelayanan kesehatan prima di wilayah Grabag & Magelang dengan fasilitas modern dan tenaga medis profesional.
            </p>
          </div>

          <!-- Quick Service Shortcuts -->
          <div class="service-highlights">
            <h3 class="section-heading">Layanan Unggulan</h3>
            <div class="service-list">
              <div class="service-item">
                <div class="service-icon-box bg-emerald">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                  </svg>
                </div>
                <div class="service-info">
                  <h4>IGD & Lab 24 Jam</h4>
                  <p>Siaga tanggap darurat medis</p>
                </div>
              </div>

              <div class="service-item">
                <div class="service-icon-box bg-teal">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                </div>
                <div class="service-info">
                  <h4>BPJS & Asuransi</h4>
                  <p>Menerima rujukan & umum</p>
                </div>
              </div>

              <div class="service-item">
                <div class="service-icon-box bg-amber">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                </div>
                <div class="service-info">
                  <h4>6 Poli Spesialis</h4>
                  <p>Umum, Anak, Kandungan, dll</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Schedule Quick Reference Box -->
          <div class="quick-schedule-box">
            <div class="schedule-box-header">
              <h4>Poliklinik Aktif</h4>
              <button id="btn-view-all-schedules" class="btn-link-action">Lihat Semua →</button>
            </div>
            <div class="mini-schedule-list">
              {polyclinics.slice(0, 3).map((poli) => (
                <div class="mini-schedule-row">
                  <span class="mini-poli-name">{poli.name}</span>
                  <span class="mini-poli-days">{poli.days}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Contact Quick Call Card -->
          <div class="emergency-help-card">
            <div class="emergency-help-content">
              <span class="emergency-badge">Emergency</span>
              <p class="emergency-text">Butuh ambulans atau penanganan darurat segera?</p>
              <div class="emergency-btn-group">
                <a href={`tel:${hospitalInfo.emergencyPhone.replace(/[^0-9]/g, '')}`} class="btn-emergency-call">
                  📞 {hospitalInfo.emergencyPhone}
                </a>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Chat Section -->
      <section class="chat-section" aria-label="Percakapan Chatbot">
        <ChatWidget />
      </section>
    </main>

    <!-- Quick Info Modal -->
    <QuickInfoModal />
  </div>
</Layout>

<style>
  .sidebar-panel {
    display: flex;
    flex-direction: column;
  }

  .sidebar-card {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: calc(100vh - 120px);
    height: calc(100dvh - 120px);
    overflow-y: auto;
  }

  /* Hospital Mini Hero */
  .hospital-mini-hero {
    border-bottom: 1px solid var(--surface-border);
    padding-bottom: 16px;
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--primary-50);
    color: var(--primary-800);
    font-size: 0.725rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 10px;
    border: 1px solid var(--primary-200);
  }

  .sidebar-hero-title {
    font-size: 1.05rem;
    color: var(--primary-900);
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  .sidebar-hero-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Service Highlights */
  .section-heading {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-subtle);
    margin-bottom: 10px;
  }

  .service-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .service-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: var(--surface-card-subtle);
    border: 1px solid var(--surface-border-subtle);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .service-item:hover {
    background: var(--primary-50);
    border-color: var(--primary-200);
    transform: translateX(2px);
  }

  .service-icon-box {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .bg-emerald {
    background: var(--primary-100);
    color: var(--primary-700);
  }

  .bg-teal {
    background: #ccfbf1;
    color: #0f766e;
  }

  .bg-amber {
    background: var(--accent-gold-light);
    color: #b45309;
  }

  .service-info h4 {
    font-size: 0.85rem;
    color: var(--text-main);
    margin: 0;
  }

  .service-info p {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Schedule Box */
  .quick-schedule-box {
    background: var(--surface-card-subtle);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-md);
    padding: 12px 14px;
  }

  .schedule-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .schedule-box-header h4 {
    font-size: 0.825rem;
    color: var(--primary-800);
    margin: 0;
  }

  .btn-link-action {
    background: none;
    border: none;
    color: var(--primary-600);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    padding: 0;
    transition: color var(--transition-fast);
  }

  .btn-link-action:hover {
    color: var(--primary-800);
    text-decoration: underline;
  }

  .mini-schedule-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mini-schedule-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.775rem;
    padding: 4px 0;
    border-bottom: 1px dashed var(--surface-border-subtle);
  }

  .mini-schedule-row:last-child {
    border-bottom: none;
  }

  .mini-poli-name {
    font-weight: 600;
    color: var(--text-main);
  }

  .mini-poli-days {
    color: var(--text-muted);
  }

  /* Emergency Card */
  .emergency-help-card {
    margin-top: auto;
    background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
    border: 1px solid #fecdd3;
    border-radius: var(--radius-md);
    padding: 14px;
  }

  .emergency-badge {
    background: var(--accent-red);
    color: white;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    display: inline-block;
    margin-bottom: 6px;
  }

  .emergency-text {
    font-size: 0.775rem;
    color: #9f1239;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .btn-emergency-call {
    display: block;
    background: #e11d48;
    color: white;
    text-align: center;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--transition-fast);
    box-shadow: 0 2px 6px rgba(225, 29, 72, 0.25);
  }

  .btn-emergency-call:hover {
    background: #be123c;
  }

  .chat-section {
    min-width: 0;
  }
</style>

<script>
  // Link to open quick info modal from sidebar
  const btnViewAll = document.getElementById('btn-view-all-schedules');
  if (btnViewAll) {
    btnViewAll.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-quick-info'));
    });
  }
</script>
