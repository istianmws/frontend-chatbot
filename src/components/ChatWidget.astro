---
import { quickSuggestions } from '../data/hospitalData.js';
---

<div class="chat-card glass-card">
  <!-- Chat Header Bar -->
  <div class="chat-header">
    <div class="chat-header-info">
      <div class="bot-avatar">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
          <rect x="3" y="8" width="18" height="12" rx="4"></rect>
          <line x1="9" y1="13" x2="9.01" y2="13"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <path d="M10 17h4"></path>
        </svg>
      </div>
      <div>
        <h2 class="chat-header-title">Customer Service Virtual PKU</h2>
        <div class="chat-status-line">
          <span class="status-indicator-dot" id="server-status-dot"></span>
          <span class="status-text" id="server-status-text">Siap Melayani</span>
        </div>
      </div>
    </div>

    <div class="chat-header-tools">
      <button id="btn-toggle-fallback" class="btn-tool-pill fallback-active" title="Klik untuk mematikan/menyalakan Knowledge Base Fallback" aria-label="Toggle Fallback Knowledge Base">
        <span class="pill-dot"></span>
        <span id="fallback-status-label">Fallback: ON</span>
      </button>

      <button id="btn-test-ai" class="btn-tool-pill test-btn" title="Uji Langsung Koneksi ke Google Gemini AI" aria-label="Tes Koneksi Gemini AI">
        <span>🧪 Tes API AI</span>
      </button>

      <button id="btn-clear-chat" class="tool-btn" title="Hapus Riwayat Chat" aria-label="Hapus Riwayat Percakapan">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 6h18"></path>
          <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
          <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Quick Suggestions Bar -->
  <div class="quick-chips-wrapper">
    <span class="chips-label">💡 Tanya Cepat:</span>
    <div class="quick-chips-scroll">
      {quickSuggestions.map((item) => (
        <button class="chip-btn quick-prompt-btn" data-query={item.query}>
          {item.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Messages Scroll Area -->
  <div id="chat-messages" class="chat-messages-container" aria-live="polite">
    <!-- Welcome Greeting Message (Bot - Left) -->
    <div class="message-row bot-row animate-fade-in">
      <div class="msg-avatar bot-avatar-icon" title="CS Virtual RS PKU">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
          <rect x="3" y="8" width="18" height="12" rx="4"></rect>
          <line x1="9" y1="13" x2="9.01" y2="13"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <path d="M10 17h4"></path>
        </svg>
      </div>
      <div class="msg-wrapper">
        <div class="msg-sender-label bot-label">🌿 CS Virtual RS PKU</div>
        <div class="msg-bubble bot-bubble">
          <div class="msg-content">
            <p><strong>Assalamu'alaikum Warahmatullahi Wabarakatuh! 🌿</strong></p>
            <p>Selamat datang di Layanan Informasi Digital <strong>RS PKU Muhammadiyah Grabag</strong>. Saya asisten virtual CS yang siap membantu Anda 24 jam non-stop.</p>
            <p>Silakan tanyakan seputar:</p>
            <ul>
              <li><strong>Jadwal Praktik Dokter</strong> & Poliklinik</li>
              <li><strong>Layanan Rawat Inap & Rawat Jalan</strong></li>
              <li><strong>Alur & Persyaratan Pendaftaran</strong> BPJS / Umum</li>
              <li><strong>Layanan Darurat IGD & Ambulans</strong></li>
            </ul>
            <p>Apa yang dapat saya bantu untuk Anda hari ini?</p>
          </div>
          <div class="msg-meta">
            <span class="msg-time" id="welcome-time">Sekarang</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Typing Indicator (Hidden by default, Left aligned) -->
  <div id="typing-indicator" class="message-row bot-row typing-row" style="display: none;">
    <div class="msg-avatar bot-avatar-icon">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
        <rect x="3" y="8" width="18" height="12" rx="4"></rect>
      </svg>
    </div>
    <div class="msg-wrapper">
      <div class="msg-sender-label bot-label">🌿 CS Virtual RS PKU (Mengetik...)</div>
      <div class="typing-bubble">
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
      </div>
    </div>
  </div>

  <!-- Input Form Area with Multimodal Controls -->
  <div class="chat-input-area">
    <!-- Hidden File Input for Image/Audio/PDF -->
    <input
      type="file"
      id="file-input"
      accept="image/*,audio/*,video/*,application/pdf"
      style="display: none;"
    />

    <!-- Attachment Preview Strip (Hidden by default) -->
    <div id="attachment-preview-bar" class="attachment-preview-bar" style="display: none;">
      <div class="attachment-info">
        <div id="attachment-thumb" class="attachment-thumb"></div>
        <div class="attachment-details">
          <span id="attachment-name" class="attachment-name"></span>
          <span id="attachment-size" class="attachment-size"></span>
        </div>
      </div>
      <button type="button" id="btn-remove-attachment" class="btn-remove-attachment" title="Hapus Lampiran">✕</button>
    </div>

    <!-- Voice Note Recording Bar (Hidden by default) -->
    <div id="voice-recording-bar" class="voice-recording-bar" style="display: none;">
      <span class="recording-pulse-dot"></span>
      <span id="recording-timer" class="recording-timer">00:00</span>
      <span class="recording-label">Merekam Suara Pasien...</span>
      <div class="recording-actions">
        <button type="button" id="btn-cancel-recording" class="btn-recording-cancel">Batal</button>
        <button type="button" id="btn-stop-recording" class="btn-recording-stop">Selesai ✓</button>
      </div>
    </div>

    <form id="chat-form" class="chat-form" onsubmit="return false;">
      <!-- Action: Attach File (Image, PDF, Audio) -->
      <button type="button" id="btn-attach-file" class="btn-input-action" title="Lampirkan Foto / Rujukan / Dokumen / Audio" aria-label="Lampirkan File">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
        </svg>
      </button>

      <!-- Action: Voice Note Recorder -->
      <button type="button" id="btn-voice-record" class="btn-input-action" title="Rekam Suara (Voice Note)" aria-label="Rekam Suara Pasien">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="23"></line>
          <line x1="8" y1="23" x2="16" y2="23"></line>
        </svg>
      </button>

      <div class="input-wrapper">
        <textarea
          id="chat-input"
          class="chat-textarea"
          placeholder="Ketik pertanyaan atau lampirkan foto surat rujukan/BPJS/suara..."
          rows="1"
          required
          aria-label="Pesan Chat"
        ></textarea>
      </div>

      <button type="submit" id="btn-send" class="btn-send" aria-label="Kirim Pesan">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
    <div class="input-footer">
      <span class="privacy-note">🔒 Mendukung Teks, Foto Surat Rujukan/BPJS, Voice Note Suara, & PDF</span>
      <span class="char-counter" id="char-counter">0 / 500</span>
    </div>
  </div>
</div>

<style is:global>
  .chat-card {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 120px);
    height: calc(100dvh - 120px);
    min-height: 520px;
    background: #ffffff;
    overflow: hidden;
    position: relative;
  }

  /* Header */
  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: #ffffff;
    border-bottom: 1px solid var(--surface-border);
    flex-shrink: 0;
  }

  .chat-header-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bot-avatar {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--primary-500), var(--primary-700));
    color: #ffffff;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
  }

  .chat-header-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary-800);
    margin: 0;
  }

  .chat-status-line {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    background: #10B981;
    border-radius: 50%;
    display: inline-block;
  }

  .chat-header-tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-tool-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg);
    color: var(--text-muted);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .btn-tool-pill.fallback-active {
    background: var(--primary-50);
    border-color: var(--primary-300);
    color: var(--primary-800);
  }

  .btn-tool-pill.fallback-disabled {
    background: #fef2f2;
    border-color: #fca5a5;
    color: #b91c1c;
  }

  .btn-tool-pill .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
  }

  .btn-tool-pill.fallback-disabled .pill-dot {
    background: #ef4444;
  }

  .btn-tool-pill.test-btn {
    background: var(--surface-card-subtle);
    border-color: var(--primary-200);
    color: var(--primary-700);
  }

  .btn-tool-pill.test-btn:hover {
    background: var(--primary-100);
    color: var(--primary-900);
    transform: translateY(-1px);
  }

  .tool-btn {
    background: transparent;
    border: 1px solid var(--surface-border);
    color: var(--text-muted);
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .tool-btn:hover {
    background: var(--accent-red-light);
    border-color: #fca5a5;
    color: var(--accent-red);
  }

  /* Quick Chips */
  .quick-chips-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    background: var(--surface-card-subtle);
    border-bottom: 1px solid var(--surface-border-subtle);
    flex-shrink: 0;
    overflow: hidden;
  }

  .chips-label {
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--primary-800);
    white-space: nowrap;
  }

  .quick-chips-scroll {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2px 0;
  }

  .quick-chips-scroll::-webkit-scrollbar {
    display: none;
  }

  /* Messages Area */
  .chat-messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    scroll-behavior: smooth;
    background: linear-gradient(180deg, #fbfdfc 0%, #f1f7f5 100%);
  }

  /* Message Row Layout: Full Width Container */
  .message-row {
    display: flex !important;
    width: 100% !important;
    gap: 12px !important;
    align-items: flex-start !important;
  }

  /* BOT (CS) - ALIGNED TO THE LEFT */
  .message-row.bot-row {
    justify-content: flex-start !important;
    flex-direction: row !important;
  }

  /* USER - ALIGNED TO THE RIGHT */
  .message-row.user-row {
    justify-content: flex-start !important;
    flex-direction: row-reverse !important;
  }

  .msg-wrapper {
    display: flex;
    flex-direction: column;
    max-width: 80%;
  }

  .bot-row .msg-wrapper {
    align-items: flex-start;
  }

  .user-row .msg-wrapper {
    align-items: flex-end;
  }

  .msg-sender-label {
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 5px;
    letter-spacing: 0.02em;
  }

  .msg-sender-label.bot-label {
    color: var(--primary-700);
    padding-left: 2px;
  }

  .msg-sender-label.user-label {
    color: #334155;
    padding-right: 2px;
  }

  /* Avatar Styles */
  .msg-avatar {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }

  .bot-avatar-icon {
    background: linear-gradient(135deg, var(--primary-600), var(--primary-800));
    color: #ffffff;
  }

  .user-avatar-icon {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    color: #ffffff;
  }

  /* Bubbles */
  .msg-bubble {
    padding: 14px 18px;
    border-radius: var(--radius-lg);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    position: relative;
    word-break: break-word;
    font-size: 0.925rem;
    line-height: 1.55;
  }

  /* Bot Bubble Styling (Left) */
  .bot-bubble {
    background: #ffffff;
    border: 1.5px solid var(--surface-border);
    border-top-left-radius: 4px;
    color: var(--text-main);
  }

  /* User Bubble Styling (Right) */
  .user-bubble {
    background: linear-gradient(135deg, #0D7C66 0%, #075E54 100%) !important;
    color: #ffffff !important;
    border-top-right-radius: 4px !important;
    box-shadow: 0 4px 14px rgba(13, 124, 102, 0.3) !important;
  }

  .user-bubble .msg-content,
  .user-bubble .msg-content p,
  .user-bubble .msg-content strong,
  .user-bubble .msg-content span {
    color: #ffffff !important;
  }

  .msg-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 0.7rem;
  }

  .bot-bubble .msg-meta {
    justify-content: flex-end;
    color: var(--text-subtle);
  }

  .user-bubble .msg-meta {
    justify-content: flex-end;
    color: rgba(255, 255, 255, 0.85);
  }

  .btn-copy-msg {
    background: var(--surface-card-subtle);
    border: 1px solid var(--surface-border);
    color: var(--primary-700);
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .btn-copy-msg:hover {
    background: var(--primary-100);
    color: var(--primary-800);
  }

  .typing-row {
    margin-top: -6px;
  }

  /* Input Area & Multimodal Controls */
  .chat-input-area {
    padding: 10px 18px 14px 18px;
    background: #ffffff;
    border-top: 1px solid var(--surface-border);
    flex-shrink: 0;
    position: relative;
  }

  /* Attachment Preview Strip */
  .attachment-preview-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--surface-card-subtle);
    border: 1px solid var(--primary-200);
    border-radius: var(--radius-md);
    margin-bottom: 8px;
    animation: fadeIn var(--transition-fast);
  }

  .attachment-info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .attachment-thumb {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: var(--primary-100);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    font-size: 1.2rem;
  }

  .attachment-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .attachment-details {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .attachment-name {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 280px;
  }

  .attachment-size {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .btn-remove-attachment {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1rem;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .btn-remove-attachment:hover {
    background: var(--accent-red-light);
    color: var(--accent-red);
  }

  /* Voice Recording Bar */
  .voice-recording-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    background: #fef2f2;
    border: 1.5px solid #fecdd3;
    border-radius: var(--radius-md);
    margin-bottom: 8px;
    animation: fadeIn var(--transition-fast);
  }

  .recording-pulse-dot {
    width: 10px;
    height: 10px;
    background: #ef4444;
    border-radius: 50%;
    animation: pulseGlow 1.2s infinite;
  }

  .recording-timer {
    font-family: monospace;
    font-weight: 800;
    font-size: 0.9rem;
    color: #b91c1c;
  }

  .recording-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #991b1b;
    flex: 1;
  }

  .recording-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-recording-cancel {
    background: transparent;
    border: 1px solid #fca5a5;
    color: #b91c1c;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .btn-recording-stop {
    background: #dc2626;
    border: none;
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .chat-form {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    background: var(--surface-card-subtle);
    border: 1.5px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 6px 8px 6px 10px;
    transition: all var(--transition-fast);
  }

  .chat-form:focus-within {
    border-color: var(--primary-500);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(13, 124, 102, 0.12);
  }

  .btn-input-action {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: transparent;
    border: none;
    color: var(--primary-700);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .btn-input-action:hover {
    background: var(--primary-100);
    color: var(--primary-900);
    transform: scale(1.05);
  }

  .input-wrapper {
    flex: 1;
    display: flex;
  }

  .chat-textarea {
    width: 100%;
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--text-main);
    resize: none;
    max-height: 120px;
    outline: none;
    padding: 6px 0;
    line-height: 1.4;
  }

  .chat-textarea::placeholder {
    color: var(--text-subtle);
  }

  .btn-send {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--primary-500), var(--primary-700));
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-fast);
    box-shadow: 0 2px 6px rgba(13, 124, 102, 0.25);
  }

  .btn-send:hover:not(:disabled) {
    background: linear-gradient(135deg, var(--primary-600), var(--primary-800));
    transform: scale(1.04);
  }

  .btn-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* File attachment in bubble */
  .msg-media-preview {
    margin-bottom: 8px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .msg-img-thumb {
    max-width: 240px;
    max-height: 200px;
    border-radius: var(--radius-md);
    display: block;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: transform var(--transition-fast);
  }

  .msg-img-thumb:hover {
    transform: scale(1.02);
  }

  .msg-audio-player {
    width: 100%;
    max-width: 260px;
    height: 38px;
    border-radius: var(--radius-full);
    outline: none;
  }

  .msg-file-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 5px 10px;
    border-radius: var(--radius-md);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .bot-bubble .msg-file-pill {
    background: var(--surface-bg);
    border-color: var(--surface-border);
    color: var(--text-main);
  }

  .input-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    padding: 0 4px;
    font-size: 0.725rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .chat-card {
      height: calc(100vh - 84px);
      height: calc(100dvh - 84px);
      border-radius: var(--radius-lg);
    }
    .message-row {
      max-width: 100%;
    }
    .msg-wrapper {
      max-width: 88%;
    }
    .privacy-note {
      font-size: 0.675rem;
    }
  }
</style>

<script>
  import { getOfflineReply } from '../data/hospitalData.js';

  // State & Element References
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('btn-send') as HTMLButtonElement;
  const messagesContainer = document.getElementById('chat-messages') as HTMLDivElement;
  const typingIndicator = document.getElementById('typing-indicator') as HTMLDivElement;
  const clearBtn = document.getElementById('btn-clear-chat') as HTMLButtonElement;
  const statusDot = document.getElementById('server-status-dot') as HTMLSpanElement;
  const statusText = document.getElementById('server-status-text') as HTMLSpanElement;
  const charCounter = document.getElementById('char-counter') as HTMLSpanElement;
  const welcomeTime = document.getElementById('welcome-time') as HTMLSpanElement;

  // Multimodal Attachment Elements
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const btnAttachFile = document.getElementById('btn-attach-file') as HTMLButtonElement;
  const btnVoiceRecord = document.getElementById('btn-voice-record') as HTMLButtonElement;
  const previewBar = document.getElementById('attachment-preview-bar') as HTMLDivElement;
  const previewThumb = document.getElementById('attachment-thumb') as HTMLDivElement;
  const previewName = document.getElementById('attachment-name') as HTMLSpanElement;
  const previewSize = document.getElementById('attachment-size') as HTMLSpanElement;
  const btnRemoveAttachment = document.getElementById('btn-remove-attachment') as HTMLButtonElement;

  // Voice Recording Elements
  const voiceBar = document.getElementById('voice-recording-bar') as HTMLDivElement;
  const recordingTimer = document.getElementById('recording-timer') as HTMLSpanElement;
  const btnCancelRecording = document.getElementById('btn-cancel-recording') as HTMLButtonElement;
  const btnStopRecording = document.getElementById('btn-stop-recording') as HTMLButtonElement;

  interface AttachedFile {
    base64: string;
    mimeType: string;
    name: string;
    sizeFormatted: string;
  }

  let currentAttachment: AttachedFile | null = null;
  let mediaRecorder: MediaRecorder | null = null;
  let audioChunks: Blob[] = [];
  let recordingInterval: any = null;
  let recordingSeconds = 0;

  // Set initial time
  if (welcomeTime) {
    welcomeTime.textContent = new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit' }).format(new Date());
  }

  // API Backend URL
  let API_ENDPOINT = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
    ? 'http://localhost:5000/api/chat'
    : '/api/chat';

  // Initial Server Health Check
  async function checkServerHealth() {
    if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') return;

    for (const port of [5000, 3000]) {
      try {
        const res = await fetch(`http://localhost:${port}/api/health`, { signal: AbortSignal.timeout(2000) });
        if (res.ok) {
          const data = await res.json();
          API_ENDPOINT = `http://localhost:${port}/api/chat`;
          if (statusDot) statusDot.style.background = '#10B981';
          if (statusText) statusText.textContent = data.gemini_configured ? 'Server AI Aktif (Gemini)' : 'Server Online (Knowledge Base)';
          return;
        }
      } catch {
        // try next port
      }
    }
    if (statusDot) statusDot.style.background = '#10B981';
    if (statusText) statusText.textContent = 'Siap Melayani';
  }
  checkServerHealth();

  // Helper format file size
  function formatBytes(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  // Set Current Attachment and Show Preview
  function setAttachment(fileData: AttachedFile | null) {
    currentAttachment = fileData;
    if (fileData) {
      if (previewBar) previewBar.style.display = 'flex';
      if (previewName) previewName.textContent = fileData.name;
      if (previewSize) previewSize.textContent = fileData.sizeFormatted;

      if (previewThumb) {
        if (fileData.mimeType.startsWith('image/')) {
          previewThumb.innerHTML = `<img src="${fileData.base64}" alt="Thumb" />`;
        } else if (fileData.mimeType.startsWith('audio/')) {
          previewThumb.innerHTML = '🎙️';
        } else if (fileData.mimeType.includes('pdf')) {
          previewThumb.innerHTML = '📄';
        } else {
          previewThumb.innerHTML = '📎';
        }
      }
      input.focus();
    } else {
      if (previewBar) previewBar.style.display = 'none';
      if (fileInput) fileInput.value = '';
    }
  }

  // Process File to Base64
  function processSelectedFile(file: File) {
    if (file.size > 20 * 1024 * 1024) {
      alert('Ukuran file maksimal 20 MB.');
      return;
    }

    const reader = new FileReader();
    reader.onload = () => {
      const base64String = reader.result as string;
      setAttachment({
        base64: base64String,
        mimeType: file.type || 'application/octet-stream',
        name: file.name,
        sizeFormatted: formatBytes(file.size)
      });
    };
    reader.readAsDataURL(file);
  }

  // File Input Trigger
  if (btnAttachFile && fileInput) {
    btnAttachFile.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files[0]) {
        processSelectedFile(files[0]);
      }
    });
  }

  if (btnRemoveAttachment) {
    btnRemoveAttachment.addEventListener('click', () => setAttachment(null));
  }

  // Paste Image Handler
  window.addEventListener('paste', (e: ClipboardEvent) => {
    if (e.clipboardData && e.clipboardData.items) {
      for (const item of Array.from(e.clipboardData.items)) {
        if (item.type.startsWith('image/')) {
          const blob = item.getAsFile();
          if (blob) processSelectedFile(blob);
          break;
        }
      }
    }
  });

  // Voice Note MediaRecorder Implementation
  if (btnVoiceRecord) {
    btnVoiceRecord.addEventListener('click', async () => {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        alert('Browser Anda belum mendukung perekaman mikrofon audio.');
        return;
      }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        audioChunks = [];
        mediaRecorder = new MediaRecorder(stream);

        mediaRecorder.ondataavailable = (event) => {
          if (event.data.size > 0) {
            audioChunks.push(event.data);
          }
        };

        mediaRecorder.onstop = () => {
          stream.getTracks().forEach(track => track.stop());
          clearInterval(recordingInterval);

          if (audioChunks.length > 0) {
            const audioBlob = new Blob(audioChunks, { type: mediaRecorder?.mimeType || 'audio/webm' });
            const reader = new FileReader();
            reader.onload = () => {
              const base64 = reader.result as string;
              setAttachment({
                base64,
                mimeType: audioBlob.type || 'audio/webm',
                name: `VoiceNote_${new Date().toLocaleTimeString('id-ID').replace(/:/g, '')}.webm`,
                sizeFormatted: formatBytes(audioBlob.size)
              });
            };
            reader.readAsDataURL(audioBlob);
          }
          if (voiceBar) voiceBar.style.display = 'none';
        };

        mediaRecorder.start();
        recordingSeconds = 0;
        if (voiceBar) voiceBar.style.display = 'flex';
        if (recordingTimer) recordingTimer.textContent = '00:00';

        recordingInterval = setInterval(() => {
          recordingSeconds++;
          const mins = Math.floor(recordingSeconds / 60).toString().padStart(2, '0');
          const secs = (recordingSeconds % 60).toString().padStart(2, '0');
          if (recordingTimer) recordingTimer.textContent = `${mins}:${secs}`;
        }, 1000);

      } catch (err: any) {
        console.error('Microphone error:', err);
        alert('Tidak dapat mengakses mikrofon.');
      }
    });
  }

  if (btnStopRecording) {
    btnStopRecording.addEventListener('click', () => {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
      }
    });
  }

  if (btnCancelRecording) {
    btnCancelRecording.addEventListener('click', () => {
      audioChunks = [];
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
      }
      clearInterval(recordingInterval);
      if (voiceBar) voiceBar.style.display = 'none';
    });
  }

  // Format Text with Basic Markdown
  function formatMarkdown(text: string): string {
    let formatted = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    formatted = formatted.replace(/\*(.*?)\*/g, '<em>$1</em>');

    const lines = formatted.split('\n');
    let inList = false;
    const processedLines = lines.map(line => {
      const trimmed = line.trim();
      if (trimmed.startsWith('• ') || trimmed.startsWith('- ')) {
        const item = trimmed.substring(2);
        if (!inList) {
          inList = true;
          return `<ul><li>${item}</li>`;
        }
        return `<li>${item}</li>`;
      } else {
        if (inList) {
          inList = false;
          return `</ul>${line ? `<p>${line}</p>` : ''}`;
        }
        return line ? `<p>${line}</p>` : '';
      }
    });

    if (inList) processedLines.push('</ul>');
    return processedLines.join('');
  }

  function getTimeString(): string {
    return new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit' }).format(new Date());
  }

  function scrollToBottom() {
    if (messagesContainer) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
  }

  // Append user or bot message
  function appendMessage(sender: 'user' | 'bot', text: string, attached?: AttachedFile | null) {
    const row = document.createElement('div');
    row.className = `message-row ${sender}-row animate-fade-in`;

    const avatar = document.createElement('div');
    avatar.className = `msg-avatar ${sender === 'user' ? 'user-avatar-icon' : 'bot-avatar-icon'}`;
    avatar.innerHTML = sender === 'user'
      ? `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`
      : `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path><rect x="3" y="8" width="18" height="12" rx="4"></rect><line x1="9" y1="13" x2="9.01" y2="13"></line><line x1="15" y1="13" x2="15.01" y2="13"></line><path d="M10 17h4"></path></svg>`;

    const wrapper = document.createElement('div');
    wrapper.className = 'msg-wrapper';

    const senderLabel = document.createElement('div');
    senderLabel.className = `msg-sender-label ${sender === 'user' ? 'user-label' : 'bot-label'}`;
    senderLabel.textContent = sender === 'user' ? 'Anda (Pasien) 👤' : '🌿 CS Virtual RS PKU';

    const bubble = document.createElement('div');
    bubble.className = `msg-bubble ${sender}-bubble`;

    if (attached) {
      const mediaBox = document.createElement('div');
      mediaBox.className = 'msg-media-preview';
      if (attached.mimeType.startsWith('image/')) {
        mediaBox.innerHTML = `<img src="${attached.base64}" alt="${attached.name}" class="msg-img-thumb" onclick="window.open(this.src)" />`;
      } else if (attached.mimeType.startsWith('audio/')) {
        mediaBox.innerHTML = `<audio src="${attached.base64}" controls class="msg-audio-player"></audio>`;
      } else {
        mediaBox.innerHTML = `<div class="msg-file-pill">📄 <span>${attached.name} (${attached.sizeFormatted})</span></div>`;
      }
      bubble.appendChild(mediaBox);
    }

    if (text && text.trim().length > 0) {
      const content = document.createElement('div');
      content.className = 'msg-content';
      content.innerHTML = sender === 'bot' ? formatMarkdown(text) : `<p>${text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>`;
      bubble.appendChild(content);
    }

    const meta = document.createElement('div');
    meta.className = 'msg-meta';
    meta.innerHTML = `
      <span class="msg-time">${getTimeString()}</span>
      ${sender === 'bot' ? `<button class="btn-copy-msg" title="Salin Jawaban" data-text="${encodeURIComponent(text)}">📋 Salin</button>` : ''}
    `;

    bubble.appendChild(meta);
    wrapper.appendChild(senderLabel);
    wrapper.appendChild(bubble);
    row.appendChild(avatar);
    row.appendChild(wrapper);

    messagesContainer.appendChild(row);
    scrollToBottom();
  }

  // Fallback Toggle State
  let isFallbackEnabled = true;
  const toggleFallbackBtn = document.getElementById('btn-toggle-fallback') as HTMLButtonElement;
  const fallbackStatusLabel = document.getElementById('fallback-status-label') as HTMLSpanElement;
  const testAiBtn = document.getElementById('btn-test-ai') as HTMLButtonElement;

  if (toggleFallbackBtn) {
    toggleFallbackBtn.addEventListener('click', () => {
      isFallbackEnabled = !isFallbackEnabled;
      if (isFallbackEnabled) {
        toggleFallbackBtn.className = 'btn-tool-pill fallback-active';
        if (fallbackStatusLabel) fallbackStatusLabel.textContent = 'Fallback: ON';
        appendMessage('bot', '🛡️ **Mode Fallback Aktif:** Jika Gemini AI mengalami gangguan/kuota habis, sistem otomatis merespons menggunakan Knowledge Base RS PKU Grabag.');
      } else {
        toggleFallbackBtn.className = 'btn-tool-pill fallback-disabled';
        if (fallbackStatusLabel) fallbackStatusLabel.textContent = 'Fallback: OFF (Pure AI)';
        appendMessage('bot', '🤖 **Mode AI Murni Aktif (Fallback Dimatikan):** Seluruh respons dan file (Foto/Audio/PDF) diproses langsung oleh Google Gemini API.');
      }
    });
  }

  // Live Test Gemini API Button Handler
  if (testAiBtn) {
    testAiBtn.addEventListener('click', async () => {
      appendMessage('user', '🧪 [Test API AI Gemini] Cek status koneksi Google Generative AI...');

      if (typingIndicator) {
        typingIndicator.style.display = 'flex';
        messagesContainer.appendChild(typingIndicator);
        scrollToBottom();
      }

      const testUrl = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
        ? 'http://localhost:5000/api/test-gemini'
        : '/api/test-gemini';

      try {
        const res = await fetch(testUrl, { signal: AbortSignal.timeout(10000) });
        const data = await res.json();

        if (typingIndicator) {
          typingIndicator.style.display = 'none';
          typingIndicator.remove();
        }

        if (data.success) {
          appendMessage('bot', `✅ **Koneksi Google Gemini Berhasil!**\n\n• **Model:** \`${data.model}\`\n• **Tes Respons AI:**\n> "${data.reply}"\n\n*API Key & Dukungan Multimodal (Gambar/Audio/PDF) aktif!*`);
        } else {
          appendMessage('bot', `❌ **Koneksi Google Gemini Gagal:**\n\n• **Model:** \`${data.model || 'unknown'}\`\n• **Pesan Error:**\n\`\`\`\n${data.error}\n\`\`\`\n\n💡 *Tips: Pastikan API Key di backend/.env sudah diisi.*`);
        }
      } catch (err: any) {
        if (typingIndicator) {
          typingIndicator.style.display = 'none';
          typingIndicator.remove();
        }
        appendMessage('bot', `⚠️ **Gagal Menghubungi Backend:**\n\`\`\`\n${err.message}\n\`\`\`\nPastikan backend di port 5000 sudah berjalan (\`npm run dev\` di folder backend).`);
      }
    });
  }

  // Send Message Logic
  async function handleSendMessage(textToSend?: string) {
    const rawMessage = textToSend !== undefined ? textToSend : input.value.trim();
    const fileToSend = currentAttachment;

    if (!rawMessage && !fileToSend) return;

    // Clear input & attachment
    input.value = '';
    input.style.height = 'auto';
    setAttachment(null);
    updateCharCount();

    // Append User Message
    appendMessage('user', rawMessage, fileToSend);

    // Show Typing Indicator
    if (typingIndicator) {
      typingIndicator.style.display = 'flex';
      messagesContainer.appendChild(typingIndicator);
      scrollToBottom();
    }

    input.disabled = true;
    sendBtn.disabled = true;

    try {
      const response = await fetch(API_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: rawMessage,
          file: fileToSend ? {
            base64: fileToSend.base64,
            mimeType: fileToSend.mimeType,
            name: fileToSend.name
          } : undefined,
          disable_fallback: !isFallbackEnabled
        }),
        signal: AbortSignal.timeout(20000)
      });

      let botReply = '';
      if (response.ok) {
        const data = await response.json();
        botReply = data.reply || data.response || "Maaf, belum ada respons dari sistem.";
        if (statusDot) statusDot.style.background = '#10B981';
        if (statusText) statusText.textContent = data.source === 'gemini-ai' ? 'Server AI Terhubung (Gemini)' : 'Server Online (Knowledge Base)';
      } else {
        throw new Error(`HTTP Error: ${response.status}`);
      }

      if (typingIndicator) {
        typingIndicator.style.display = 'none';
        typingIndicator.remove();
      }
      appendMessage('bot', botReply);

    } catch (err: any) {
      if (typingIndicator) {
        typingIndicator.style.display = 'none';
        typingIndicator.remove();
      }

      if (!isFallbackEnabled) {
        if (statusDot) statusDot.style.background = '#EF4444';
        if (statusText) statusText.textContent = 'Koneksi Error';
        appendMessage('bot', `⚠️ **[Error Koneksi Backend / API]**\n\nTidak dapat menghubungi backend API pada \`${API_ENDPOINT}\`.\n\`\`\`\n${err.message}\n\`\`\``);
      } else {
        console.warn('Backend API not reachable, switching to local RS knowledge engine:', err);
        if (statusDot) statusDot.style.background = '#F59E0B';
        if (statusText) statusText.textContent = 'Mode Cerdas Offline';

        await new Promise((res) => setTimeout(res, 600));
        const fallbackReply = getOfflineReply(rawMessage || (fileToSend ? 'lampiran' : ''));
        appendMessage('bot', fallbackReply);
      }
    } finally {
      if (typingIndicator) {
        typingIndicator.style.display = 'none';
        typingIndicator.remove();
      }
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
      scrollToBottom();
    }
  }

  // Event Listeners
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      handleSendMessage();
    });
  }

  if (input) {
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleSendMessage();
      }
    });

    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
      updateCharCount();
    });
  }

  function updateCharCount() {
    if (charCounter && input) {
      const len = input.value.length;
      charCounter.textContent = `${len} / 500`;
      charCounter.style.color = (len > 450) ? 'var(--accent-red)' : 'var(--text-muted)';
    }
  }

  // Quick Prompt Chips
  const quickButtons = document.querySelectorAll('.quick-prompt-btn');
  quickButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const query = btn.getAttribute('data-query');
      if (query) handleSendMessage(query);
    });
  });

  // Clear Chat History
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (confirm('Bersihkan riwayat obrolan?')) {
        const allRows = messagesContainer.querySelectorAll('.message-row:not(:first-child)');
        allRows.forEach(row => row.remove());
        if (typingIndicator) typingIndicator.style.display = 'none';
      }
    });
  }

  // Copy Message Listener
  if (messagesContainer) {
    messagesContainer.addEventListener('click', async (e) => {
      const target = (e.target as HTMLElement).closest('.btn-copy-msg') as HTMLButtonElement;
      if (target) {
        const encoded = target.getAttribute('data-text');
        if (encoded) {
          const text = decodeURIComponent(encoded);
          try {
            await navigator.clipboard.writeText(text);
            const originalHTML = target.innerHTML;
            target.innerHTML = '✅ Tersalin!';
            setTimeout(() => { target.innerHTML = originalHTML; }, 1800);
          } catch (err) { console.error('Failed to copy', err); }
        }
      }
    });
  }
</script>
