---
import { quickSuggestions } from '../data/hospitalData.js';
---

<div class="chat-card glass-card">
  <!-- Chat Header Bar -->
  <div class="chat-header">
    <div class="chat-header-info">
      <div class="bot-avatar">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
          <rect x="3" y="8" width="18" height="12" rx="4"></rect>
          <line x1="9" y1="13" x2="9.01" y2="13"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <path d="M10 17h4"></path>
        </svg>
      </div>
      <div>
        <h2 class="chat-header-title">Customer Service Virtual PKU</h2>
        <div class="chat-status-line">
          <span class="status-indicator-dot" id="server-status-dot"></span>
          <span class="status-text" id="server-status-text">Siap Melayani</span>
        </div>
      </div>
    </div>

    <div class="chat-header-tools">
      <button id="btn-toggle-fallback" class="btn-tool-pill fallback-active" title="Klik untuk mematikan/menyalakan Knowledge Base Fallback" aria-label="Toggle Fallback Knowledge Base">
        <span class="pill-dot"></span>
        <span id="fallback-status-label">Fallback: ON</span>
      </button>

      <button id="btn-test-ai" class="btn-tool-pill test-btn" title="Uji Langsung Koneksi ke Google Gemini AI" aria-label="Tes Koneksi Gemini AI">
        <span>🧪 Tes API AI</span>
      </button>

      <button id="btn-clear-chat" class="tool-btn" title="Hapus Riwayat Chat" aria-label="Hapus Riwayat Percakapan">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 6h18"></path>
          <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
          <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Quick Suggestions Bar -->
  <div class="quick-chips-wrapper">
    <span class="chips-label">💡 Tanya Cepat:</span>
    <div class="quick-chips-scroll">
      {quickSuggestions.map((item) => (
        <button class="chip-btn quick-prompt-btn" data-query={item.query}>
          {item.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Messages Scroll Area -->
  <div id="chat-messages" class="chat-messages-container" aria-live="polite">
    <!-- Welcome Greeting Message (Bot - Left) -->
    <div class="message-row bot-row animate-fade-in">
      <div class="msg-avatar bot-avatar-icon" title="CS Virtual RS PKU">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
          <rect x="3" y="8" width="18" height="12" rx="4"></rect>
          <line x1="9" y1="13" x2="9.01" y2="13"></line>
          <line x1="15" y1="13" x2="15.01" y2="13"></line>
          <path d="M10 17h4"></path>
        </svg>
      </div>
      <div class="msg-wrapper">
        <div class="msg-sender-label bot-label">🌿 CS Virtual RS PKU</div>
        <div class="msg-bubble bot-bubble">
          <div class="msg-content">
            <p><strong>Assalamu'alaikum Warahmatullahi Wabarakatuh! 🌿</strong></p>
            <p>Selamat datang di Layanan Informasi Digital <strong>RS PKU Muhammadiyah Grabag</strong>. Saya asisten virtual CS yang siap membantu Anda 24 jam non-stop.</p>
            <p>Silakan tanyakan seputar:</p>
            <ul>
              <li><strong>Jadwal Praktik Dokter</strong> & Poliklinik</li>
              <li><strong>Layanan Rawat Inap & Rawat Jalan</strong></li>
              <li><strong>Alur & Persyaratan Pendaftaran</strong> BPJS / Umum</li>
              <li><strong>Layanan Darurat IGD & Ambulans</strong></li>
            </ul>
            <p>Apa yang dapat saya bantu untuk Anda hari ini?</p>
          </div>
          <div class="msg-meta">
            <span class="msg-time" id="welcome-time">Sekarang</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Typing Indicator (Hidden by default, Left aligned) -->
  <div id="typing-indicator" class="message-row bot-row typing-row" style="display: none;">
    <div class="msg-avatar bot-avatar-icon">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
        <rect x="3" y="8" width="18" height="12" rx="4"></rect>
      </svg>
    </div>
    <div class="msg-wrapper">
      <div class="msg-sender-label bot-label">🌿 CS Virtual RS PKU (Mengetik...)</div>
      <div class="typing-bubble">
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
      </div>
    </div>
  </div>

  <!-- Input Form Area -->
  <div class="chat-input-area">
    <form id="chat-form" class="chat-form" onsubmit="return false;">
      <div class="input-wrapper">
        <textarea
          id="chat-input"
          class="chat-textarea"
          placeholder="Ketik pertanyaan Anda di sini... (contoh: Jadwal dokter anak hari apa?)"
          rows="1"
          required
          aria-label="Pesan Chat"
        ></textarea>
      </div>

      <button type="submit" id="btn-send" class="btn-send" aria-label="Kirim Pesan">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
    <div class="input-footer">
      <span class="privacy-note">🔒 Layanan CS Resmi RS PKU Grabag • Tanggapan cepat berbasis AI</span>
      <span class="char-counter" id="char-counter">0 / 500</span>
    </div>
  </div>
</div>

<style is:global>
  .chat-card {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 120px);
    height: calc(100dvh - 120px);
    min-height: 520px;
    background: #ffffff;
    overflow: hidden;
    position: relative;
  }

  /* Header */
  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: #ffffff;
    border-bottom: 1px solid var(--surface-border);
    flex-shrink: 0;
  }

  .chat-header-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .bot-avatar {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--primary-500), var(--primary-700));
    color: #ffffff;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
  }

  .chat-header-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary-800);
    margin: 0;
  }

  .chat-status-line {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    background: #10B981;
    border-radius: 50%;
    display: inline-block;
  }

  .chat-header-tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-tool-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid var(--surface-border);
    background: var(--surface-bg);
    color: var(--text-muted);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .btn-tool-pill.fallback-active {
    background: var(--primary-50);
    border-color: var(--primary-300);
    color: var(--primary-800);
  }

  .btn-tool-pill.fallback-disabled {
    background: #fef2f2;
    border-color: #fca5a5;
    color: #b91c1c;
  }

  .btn-tool-pill .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
  }

  .btn-tool-pill.fallback-disabled .pill-dot {
    background: #ef4444;
  }

  .btn-tool-pill.test-btn {
    background: var(--surface-card-subtle);
    border-color: var(--primary-200);
    color: var(--primary-700);
  }

  .btn-tool-pill.test-btn:hover {
    background: var(--primary-100);
    color: var(--primary-900);
    transform: translateY(-1px);
  }

  .tool-btn {
    background: transparent;
    border: 1px solid var(--surface-border);
    color: var(--text-muted);
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .tool-btn:hover {
    background: var(--accent-red-light);
    border-color: #fca5a5;
    color: var(--accent-red);
  }

  /* Quick Chips */
  .quick-chips-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    background: var(--surface-card-subtle);
    border-bottom: 1px solid var(--surface-border-subtle);
    flex-shrink: 0;
    overflow: hidden;
  }

  .chips-label {
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--primary-800);
    white-space: nowrap;
  }

  .quick-chips-scroll {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2px 0;
  }

  .quick-chips-scroll::-webkit-scrollbar {
    display: none;
  }

  /* Messages Area */
  .chat-messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    scroll-behavior: smooth;
    background: linear-gradient(180deg, #fbfdfc 0%, #f1f7f5 100%);
  }

  /* Message Row Layout: Full Width Container */
  .message-row {
    display: flex !important;
    width: 100% !important;
    gap: 12px !important;
    align-items: flex-start !important;
  }

  /* BOT (CS) - ALIGNED TO THE LEFT */
  .message-row.bot-row {
    justify-content: flex-start !important;
    flex-direction: row !important;
  }

  /* USER - ALIGNED TO THE RIGHT */
  .message-row.user-row {
    justify-content: flex-start !important;
    flex-direction: row-reverse !important;
  }

  .msg-wrapper {
    display: flex;
    flex-direction: column;
    max-width: 80%;
  }

  .bot-row .msg-wrapper {
    align-items: flex-start;
  }

  .user-row .msg-wrapper {
    align-items: flex-end;
  }

  .msg-sender-label {
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 5px;
    letter-spacing: 0.02em;
  }

  .msg-sender-label.bot-label {
    color: var(--primary-700);
    padding-left: 2px;
  }

  .msg-sender-label.user-label {
    color: #334155;
    padding-right: 2px;
  }

  /* Avatar Styles */
  .msg-avatar {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }

  .bot-avatar-icon {
    background: linear-gradient(135deg, var(--primary-600), var(--primary-800));
    color: #ffffff;
  }

  .user-avatar-icon {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    color: #ffffff;
  }

  /* Bubbles */
  .msg-bubble {
    padding: 14px 18px;
    border-radius: var(--radius-lg);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    position: relative;
    word-break: break-word;
    font-size: 0.925rem;
    line-height: 1.55;
  }

  /* Bot Bubble Styling (Left) */
  .bot-bubble {
    background: #ffffff;
    border: 1.5px solid var(--surface-border);
    border-top-left-radius: 4px;
    color: var(--text-main);
  }

  /* User Bubble Styling (Right) */
  .user-bubble {
    background: linear-gradient(135deg, #0D7C66 0%, #075E54 100%) !important;
    color: #ffffff !important;
    border-top-right-radius: 4px !important;
    box-shadow: 0 4px 14px rgba(13, 124, 102, 0.3) !important;
  }

  .user-bubble .msg-content,
  .user-bubble .msg-content p,
  .user-bubble .msg-content strong,
  .user-bubble .msg-content span {
    color: #ffffff !important;
  }

  .msg-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 0.7rem;
  }

  .bot-bubble .msg-meta {
    justify-content: flex-end;
    color: var(--text-subtle);
  }

  .user-bubble .msg-meta {
    justify-content: flex-end;
    color: rgba(255, 255, 255, 0.85);
  }

  .btn-copy-msg {
    background: var(--surface-card-subtle);
    border: 1px solid var(--surface-border);
    color: var(--primary-700);
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .btn-copy-msg:hover {
    background: var(--primary-100);
    color: var(--primary-800);
  }

  .typing-row {
    margin-top: -6px;
  }

  /* Input Area */
  .chat-input-area {
    padding: 12px 18px 14px 18px;
    background: #ffffff;
    border-top: 1px solid var(--surface-border);
    flex-shrink: 0;
  }

  .chat-form {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    background: var(--surface-card-subtle);
    border: 1.5px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 6px 8px 6px 14px;
    transition: all var(--transition-fast);
  }

  .chat-form:focus-within {
    border-color: var(--primary-500);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(13, 124, 102, 0.12);
  }

  .input-wrapper {
    flex: 1;
    display: flex;
  }

  .chat-textarea {
    width: 100%;
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--text-main);
    resize: none;
    max-height: 120px;
    outline: none;
    padding: 6px 0;
    line-height: 1.4;
  }

  .chat-textarea::placeholder {
    color: var(--text-subtle);
  }

  .btn-send {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--primary-500), var(--primary-700));
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-fast);
    box-shadow: 0 2px 6px rgba(13, 124, 102, 0.25);
  }

  .btn-send:hover:not(:disabled) {
    background: linear-gradient(135deg, var(--primary-600), var(--primary-800));
    transform: scale(1.04);
  }

  .btn-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .input-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    padding: 0 4px;
    font-size: 0.725rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .chat-card {
      height: calc(100vh - 84px);
      height: calc(100dvh - 84px);
      border-radius: var(--radius-lg);
    }
    .message-row {
      max-width: 100%;
    }
    .msg-wrapper {
      max-width: 88%;
    }
    .privacy-note {
      font-size: 0.675rem;
    }
  }
</style>

<script>
  import { getOfflineReply } from '../data/hospitalData.js';

  // State & Element References
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('btn-send') as HTMLButtonElement;
  const messagesContainer = document.getElementById('chat-messages') as HTMLDivElement;
  const typingIndicator = document.getElementById('typing-indicator') as HTMLDivElement;
  const clearBtn = document.getElementById('btn-clear-chat') as HTMLButtonElement;
  const statusDot = document.getElementById('server-status-dot') as HTMLSpanElement;
  const statusText = document.getElementById('server-status-text') as HTMLSpanElement;
  const charCounter = document.getElementById('char-counter') as HTMLSpanElement;
  const welcomeTime = document.getElementById('welcome-time') as HTMLSpanElement;

  // Set initial time
  if (welcomeTime) {
    welcomeTime.textContent = new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit' }).format(new Date());
  }

  // API Backend URL (Express localhost:5000 fallback to relative /api/chat)
  let API_ENDPOINT = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
    ? 'http://localhost:5000/api/chat'
    : '/api/chat';

  // Initial Server Health Check (checks port 5000 first, then 3000)
  async function checkServerHealth() {
    if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') return;

    for (const port of [5000, 3000]) {
      try {
        const res = await fetch(`http://localhost:${port}/api/health`, { signal: AbortSignal.timeout(2000) });
        if (res.ok) {
          const data = await res.json();
          API_ENDPOINT = `http://localhost:${port}/api/chat`;
          if (statusDot) statusDot.style.background = '#10B981';
          if (statusText) statusText.textContent = data.gemini_configured ? 'Server AI Aktif (Gemini)' : 'Server Online (Knowledge Base)';
          return;
        }
      } catch {
        // try next port
      }
    }
    if (statusDot) statusDot.style.background = '#10B981';
    if (statusText) statusText.textContent = 'Siap Melayani';
  }
  checkServerHealth();

  // Format Text with Basic Markdown
  function formatMarkdown(text: string): string {
    let formatted = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // Bold **text**
    formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    // Italic *text*
    formatted = formatted.replace(/\*(.*?)\*/g, '<em>$1</em>');

    // Bullet points lines
    const lines = formatted.split('\n');
    let inList = false;
    const processedLines = lines.map(line => {
      const trimmed = line.trim();
      if (trimmed.startsWith('• ') || trimmed.startsWith('- ')) {
        const item = trimmed.substring(2);
        if (!inList) {
          inList = true;
          return `<ul><li>${item}</li>`;
        }
        return `<li>${item}</li>`;
      } else {
        if (inList) {
          inList = false;
          return `</ul>${line ? `<p>${line}</p>` : ''}`;
        }
        return line ? `<p>${line}</p>` : '';
      }
    });

    if (inList) {
      processedLines.push('</ul>');
    }

    return processedLines.join('');
  }

  function getTimeString(): string {
    return new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit' }).format(new Date());
  }

  function scrollToBottom() {
    if (messagesContainer) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
  }

  // Append user or bot message
  function appendMessage(sender: 'user' | 'bot', text: string) {
    const row = document.createElement('div');
    row.className = `message-row ${sender}-row animate-fade-in`;

    const avatar = document.createElement('div');
    avatar.className = `msg-avatar ${sender === 'user' ? 'user-avatar-icon' : 'bot-avatar-icon'}`;
    avatar.innerHTML = sender === 'user'
      ? `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`
      : `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path><rect x="3" y="8" width="18" height="12" rx="4"></rect><line x1="9" y1="13" x2="9.01" y2="13"></line><line x1="15" y1="13" x2="15.01" y2="13"></line><path d="M10 17h4"></path></svg>`;

    const wrapper = document.createElement('div');
    wrapper.className = 'msg-wrapper';

    const senderLabel = document.createElement('div');
    senderLabel.className = `msg-sender-label ${sender === 'user' ? 'user-label' : 'bot-label'}`;
    senderLabel.textContent = sender === 'user' ? 'Anda (Pasien) 👤' : '🌿 CS Virtual RS PKU';

    const bubble = document.createElement('div');
    bubble.className = `msg-bubble ${sender}-bubble`;

    const content = document.createElement('div');
    content.className = 'msg-content';
    content.innerHTML = sender === 'bot' ? formatMarkdown(text) : `<p>${text.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>`;

    const meta = document.createElement('div');
    meta.className = 'msg-meta';
    meta.innerHTML = `
      <span class="msg-time">${getTimeString()}</span>
      ${sender === 'bot' ? `<button class="btn-copy-msg" title="Salin Jawaban" data-text="${encodeURIComponent(text)}">📋 Salin</button>` : ''}
    `;

    bubble.appendChild(content);
    bubble.appendChild(meta);

    wrapper.appendChild(senderLabel);
    wrapper.appendChild(bubble);

    row.appendChild(avatar);
    row.appendChild(wrapper);

    messagesContainer.appendChild(row);
    scrollToBottom();
  }

  // Fallback Toggle State
  let isFallbackEnabled = true;
  const toggleFallbackBtn = document.getElementById('btn-toggle-fallback') as HTMLButtonElement;
  const fallbackStatusLabel = document.getElementById('fallback-status-label') as HTMLSpanElement;
  const testAiBtn = document.getElementById('btn-test-ai') as HTMLButtonElement;

  if (toggleFallbackBtn) {
    toggleFallbackBtn.addEventListener('click', () => {
      isFallbackEnabled = !isFallbackEnabled;
      if (isFallbackEnabled) {
        toggleFallbackBtn.className = 'btn-tool-pill fallback-active';
        if (fallbackStatusLabel) fallbackStatusLabel.textContent = 'Fallback: ON';
        appendMessage('bot', '🛡️ **Mode Fallback Aktif:** Jika Gemini AI mengalami gangguan/kuota habis, sistem otomatis merespons menggunakan Knowledge Base RS PKU Grabag.');
      } else {
        toggleFallbackBtn.className = 'btn-tool-pill fallback-disabled';
        if (fallbackStatusLabel) fallbackStatusLabel.textContent = 'Fallback: OFF (Pure AI)';
        appendMessage('bot', '🤖 **Mode AI Murni Aktif (Fallback Dimatikan):** Seluruh respons akan diproses langsung oleh Google Gemini API. Jika ada error atau model salah, pesan error asli dari Google akan ditampilkan di chat.');
      }
    });
  }

  // Live Test Gemini API Button Handler
  if (testAiBtn) {
    testAiBtn.addEventListener('click', async () => {
      appendMessage('user', '🧪 [Test API AI Gemini] Cek status koneksi Google Generative AI...');

      if (typingIndicator) {
        typingIndicator.style.display = 'flex';
        messagesContainer.appendChild(typingIndicator);
        scrollToBottom();
      }

      const testUrl = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
        ? 'http://localhost:5000/api/test-gemini'
        : '/api/test-gemini';

      try {
        const res = await fetch(testUrl, { signal: AbortSignal.timeout(10000) });
        const data = await res.json();

        if (typingIndicator) {
          typingIndicator.style.display = 'none';
          typingIndicator.remove();
        }

        if (data.success) {
          appendMessage('bot', `✅ **Koneksi Google Gemini Berhasil!**\n\n• **Model:** \`${data.model}\`\n• **Tes Respons AI:**\n> "${data.reply}"\n\n*API Key Anda aktif dan siap melayani percakapan!*`);
        } else {
          appendMessage('bot', `❌ **Koneksi Google Gemini Gagal:**\n\n• **Model:** \`${data.model || 'unknown'}\`\n• **Pesan Error:**\n\`\`\`\n${data.error}\n\`\`\`\n\n💡 *Tips: Pastikan API Key di backend/.env adalah API Key Google AI Studio (format: AIzaSy...) dan model yang terdaftar.*`);
        }
      } catch (err: any) {
        if (typingIndicator) {
          typingIndicator.style.display = 'none';
          typingIndicator.remove();
        }
        appendMessage('bot', `⚠️ **Gagal Menghubungi Backend:**\n\`\`\`\n${err.message}\n\`\`\`\nPastikan backend di port 5000 sudah berjalan (\`npm run dev\` di folder backend).`);
      }
    });
  }

  // Send Message Logic
  async function handleSendMessage(textToSend?: string) {
    const rawMessage = textToSend !== undefined ? textToSend : input.value.trim();
    if (!rawMessage) return;

    // Clear input
    input.value = '';
    input.style.height = 'auto';
    updateCharCount();

    // Append User Message
    appendMessage('user', rawMessage);

    // Show Typing Indicator
    if (typingIndicator) {
      typingIndicator.style.display = 'flex';
      messagesContainer.appendChild(typingIndicator);
      scrollToBottom();
    }

    // Disable input while processing
    input.disabled = true;
    sendBtn.disabled = true;

    try {
      // 1. Attempt to call Backend API (Express /api/chat)
      const response = await fetch(API_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: rawMessage,
          disable_fallback: !isFallbackEnabled
        }),
        signal: AbortSignal.timeout(10000) // 10 seconds timeout
      });

      let botReply = '';
      if (response.ok) {
        const data = await response.json();
        botReply = data.reply || data.response || "Maaf, belum ada respons dari sistem.";
        if (statusDot) statusDot.style.background = '#10B981';
        if (statusText) statusText.textContent = data.source === 'gemini-ai' ? 'Server AI Terhubung (Gemini)' : 'Server Online (Knowledge Base)';
      } else {
        throw new Error(`HTTP Error: ${response.status}`);
      }

      // Hide typing before appending reply
      if (typingIndicator) {
        typingIndicator.style.display = 'none';
        typingIndicator.remove();
      }
      appendMessage('bot', botReply);

    } catch (err: any) {
      if (typingIndicator) {
        typingIndicator.style.display = 'none';
        typingIndicator.remove();
      }

      if (!isFallbackEnabled) {
        // When Fallback is disabled by user, show the exact network error
        if (statusDot) statusDot.style.background = '#EF4444';
        if (statusText) statusText.textContent = 'Koneksi Error';
        appendMessage('bot', `⚠️ **[Error Koneksi Backend / API]**\n\nTidak dapat menghubungi backend API pada \`${API_ENDPOINT}\`.\n\`\`\`\n${err.message}\n\`\`\``);
      } else {
        // Fallback: If backend is offline or during testing, use smart offline knowledge engine
        console.warn('Backend API not reachable, switching to local RS knowledge engine:', err);
        if (statusDot) statusDot.style.background = '#F59E0B';
        if (statusText) statusText.textContent = 'Mode Cerdas Offline';

        // Simulate realistic typing delay
        await new Promise((res) => setTimeout(res, 600));
        const fallbackReply = getOfflineReply(rawMessage);
        appendMessage('bot', fallbackReply);
      }
    } finally {
      // Ensure typing is hidden and reset input
      if (typingIndicator) {
        typingIndicator.style.display = 'none';
        typingIndicator.remove();
      }
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
      scrollToBottom();
    }
  }

  // Event Listeners
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      handleSendMessage();
    });
  }

  // Keydown Enter (Enter sends, Shift+Enter makes newline)
  if (input) {
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleSendMessage();
      }
    });

    // Auto resize textarea height
    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
      updateCharCount();
    });
  }

  function updateCharCount() {
    if (charCounter && input) {
      const len = input.value.length;
      charCounter.textContent = `${len} / 500`;
      if (len > 450) {
        charCounter.style.color = 'var(--accent-red)';
      } else {
        charCounter.style.color = 'var(--text-muted)';
      }
    }
  }

  // Quick Prompt Chips Click
  const quickButtons = document.querySelectorAll('.quick-prompt-btn');
  quickButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const query = btn.getAttribute('data-query');
      if (query) {
        handleSendMessage(query);
      }
    });
  });

  // Clear Chat History
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (confirm('Bersihkan riwayat obrolan?')) {
        // Keep initial welcome message
        const allRows = messagesContainer.querySelectorAll('.message-row:not(:first-child)');
        allRows.forEach(row => row.remove());
        if (typingIndicator) typingIndicator.style.display = 'none';
      }
    });
  }

  // Copy Message Listener Delegation
  if (messagesContainer) {
    messagesContainer.addEventListener('click', async (e) => {
      const target = (e.target as HTMLElement).closest('.btn-copy-msg') as HTMLButtonElement;
      if (target) {
        const encoded = target.getAttribute('data-text');
        if (encoded) {
          const text = decodeURIComponent(encoded);
          try {
            await navigator.clipboard.writeText(text);
            const originalHTML = target.innerHTML;
            target.innerHTML = '✅ Tersalin!';
            setTimeout(() => {
              target.innerHTML = originalHTML;
            }, 1800);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        }
      }
    });
  }
</script>
