---
import { hospitalInfo } from '../data/hospitalData.js';
---

<header class="header-glass">
  <div class="header-content">
    <div class="brand-group">
      <div class="logo-wrapper">
        <svg class="logo-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="18" cy="18" r="17" fill="#0D7C66" stroke="#41B3A2" stroke-width="2"/>
          <path d="M18 9V27M9 18H27" stroke="#ffffff" stroke-width="4" stroke-linecap="round"/>
          <circle cx="18" cy="18" r="4.5" fill="#F59E0B"/>
        </svg>
        <span class="status-dot-pulse" title="Layanan Aktif 24 Jam"></span>
      </div>
      <div class="brand-text">
        <div class="brand-title-row">
          <h1 class="brand-name">RS PKU MUHAMMADIYAH GRABAG</h1>
          <span class="badge-tag">CS AI 24 Jam</span>
        </div>
        <p class="brand-tagline">Layanan Informasi Pasien, Jadwal Dokter & Pendaftaran</p>
      </div>
    </div>

    <div class="header-actions">
      <button id="btn-open-quick-info" class="btn-header-secondary" aria-label="Buka Informasi Cepat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span class="hide-mobile">Panduan RS</span>
      </button>

      <a href={`tel:${hospitalInfo.emergencyPhone.replace(/[^0-9]/g, '')}`} class="btn-header-emergency" title="Hubungi IGD Darurat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>IGD Darurat</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header-glass {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 12px 20px;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-wrapper {
    position: relative;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .logo-icon {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 4px rgba(13, 124, 102, 0.2));
  }

  .status-dot-pulse {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 12px;
    height: 12px;
    background-color: #10B981;
    border: 2.5px solid #ffffff;
    border-radius: 50%;
    animation: pulseGlow 2s infinite;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .brand-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--primary-700);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .badge-tag {
    background: var(--primary-50);
    color: var(--primary-600);
    border: 1px solid var(--primary-200);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .brand-tagline {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .btn-header-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface-bg);
    border: 1px solid var(--surface-border);
    color: var(--text-main);
    padding: 8px 14px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-header-secondary:hover {
    background: var(--primary-50);
    border-color: var(--primary-300);
    color: var(--primary-700);
  }

  .btn-header-emergency {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 3px 8px rgba(239, 68, 68, 0.3);
    transition: all var(--transition-fast);
  }

  .btn-header-emergency:hover {
    background: linear-gradient(135deg, #dc2626, #b91c1c);
    transform: translateY(-1px);
    box-shadow: 0 5px 12px rgba(239, 68, 68, 0.4);
  }

  @media (max-width: 640px) {
    .header-glass {
      padding: 10px 14px;
    }
    .brand-name {
      font-size: 0.925rem;
    }
    .brand-tagline {
      display: none;
    }
    .hide-mobile {
      display: none;
    }
    .btn-header-secondary, .btn-header-emergency {
      padding: 7px 10px;
      font-size: 0.8rem;
    }
  }
</style>
